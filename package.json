{
  "name": "dsh-display-panel",
  "version": "0.2.2",
  "description": "A display tab for the DeepSeek Harness Web UI: watch — and drive — the AI's own headless test display (per-session, isolated, with mouse/keyboard injected back).",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "lib",
    "scripts",
    "scripts/publish-npm.sh",
    "service",
    "service/selfcheck.py",
    "service/windows"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "display",
    "vnc",
    "xvfb",
    "panel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xugulin/dsh-display-panel.git"
  },
  "homepage": "https://github.com/xugulin/dsh-display-panel#readme",
  "scripts": {
    "prepack": "rm -rf service/__pycache__ lib/__pycache__ scripts/__pycache__"
  }
}
