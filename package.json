{
  "name": "dsh-display-panel",
  "version": "0.6.1",
  "description": "Display tab for the DeepSeek Harness Web UI: watch and drive the AI's own per-session display. The browser half only talks to the same-origin /api/dsh-display-panel/* proxy (the access token never reaches the browser), and the host half starts the viewer service on demand.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "docs",
    "lib",
    "scripts",
    "service",
    "tools"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "display",
    "panel",
    "vnc",
    "xvfb",
    "x11",
    "screenshot",
    "agent-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xugulin/dsh-display-panel.git"
  },
  "homepage": "https://github.com/xugulin/dsh-display-panel#readme",
  "scripts": {
    "prepack": "rm -rf service/__pycache__ lib/__pycache__ scripts/__pycache__ tools/__pycache__",
    "selfcheck": "python3 service/selfcheck.py",
    "test": "python3 tools/selftest.py",
    "hint": "node scripts/hint.js"
  }
}
